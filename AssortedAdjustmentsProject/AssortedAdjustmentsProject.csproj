<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<LangVersion>8.0</LangVersion>
		<OutputType>Library</OutputType>
		<AppDesignerFolder>Properties</AppDesignerFolder>
		<RootNamespace>SergeyWaytov.AssortedAdjustmentsProject</RootNamespace>
		<AssemblyName>SergeyWaytov_AssortedAdjustmentsProject</AssemblyName>
		<Deterministic>true</Deterministic>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<OutputPath>..\Dist</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
		<Optimize>false</Optimize>
		<DefineConstants>DEBUG;TRACE</DefineConstants>
	</PropertyGroup>

	<!-- AAP B2: Release config no longer ships a ~280KB PDB with
             build-machine paths. DebugSymbols=false + DebugType=none
             strips all symbols from the distributable. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugSymbols>false</DebugSymbols>
		<DebugType>none</DebugType>
		<Optimize>true</Optimize>
		<DefineConstants>TRACE</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="AAPConfig.cs" />
		<Compile Include="AbilityPatches.cs" />
		<Compile Include="AmbushDisabler.cs" />
		<Compile Include="ArmorPatches.cs" />
		<Compile Include="AssortedAdjustmentsProjectMain.cs" />
		<Compile Include="CorruptedHorizonsAdjustments.cs" />
		<Compile Include="DefCache.cs" />
		<Compile Include="DeploymentCapPatch.cs" />
		<Compile Include="EconomyAmbushPatches.cs" />
		<Compile Include="FesteringSkiesAdjustments.cs" />
		<Compile Include="GeoscapeFacilitiesPatches.cs" />
		<Compile Include="Helpers.cs" />
		<Compile Include="LimitedWarAdjustments.cs" />
		<Compile Include="LootMechanics.cs" />
		<Compile Include="PrecisionShot.cs" />
		<Compile Include="Properties\AssemblyInfo.cs" />
		<Compile Include="PsychicBuffManager.cs" />
		<Compile Include="PsychicResearchConditions.cs" />
		<Compile Include="RageBurstPatch.cs" />
		<Compile Include="RepairCosts.cs" />
		<Compile Include="ResearchCompletePopupPatch.cs" />
		<Compile Include="ReturnFirePatch.cs" />
		<Compile Include="ScrapAircraftFix.cs" />
		<Compile Include="SmartEvacuationPatch.cs" />
		<Compile Include="TutorialJacobFixPatch.cs" />
		<Compile Include="UIPatches.cs" />
		<Compile Include="UI_ExtendedAgendaTracker.cs" />
		<Compile Include="UI_ExtendedBaselineInfo.cs" />
		<Compile Include="UI_RecruitInfo.cs" />
		<Compile Include="UI_SmartBaseSelection.cs" />
		<Compile Include="VehiclePatches.cs" />
		<Compile Include="WeaponPatches.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Include="meta.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<Content Include="Localization\AAP_Localization.csv">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>Assets\Localization\AAP_Localization.csv</Link>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Reference Include="0Harmony">
			<HintPath>..\ModSDK\0Harmony.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Assembly-CSharp">
			<HintPath>..\ModSDK\Assembly-CSharp.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Unity.TextMeshPro">
			<HintPath>..\ModSDK\Unity.TextMeshPro.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>..\ModSDK\UnityEngine.CoreModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.UI">
			<HintPath>..\ModSDK\UnityEngine.UI.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>

	<!-- AAP post-build guard (opt-out, default ON): the original
             PostBuild target ran an UNCONDITIONAL RMDIR /S /Q + XCOPY
             against TestMod on every build. During the 2-agent audit this
             wiped a third-party mod sitting in TestMod. The audit's B2
             recommendation was to make deploy-on-build opt-in; but that
             broke the developer's normal rebuild-to-TestMod auto-deploy
             loop. Inverted to opt-out (default ON) to restore the dev loop
             while preserving the audit's safety valve:

               - Default (property unset/empty): deploy runs (matches original).
               - Set DeployToPhoenixPointTestMod=false to SKIP deploy
                 (for clean ship builds or shared build machines).
               - The external Directory.Build.targets file from the release
                 bundle (drop at repo root beside the .sln) overrides EVERY
                 PostBuild with a no-op, regardless of this property.
                 Use that as the nuclear off-switch for audit-mode builds.

             AfterTargets=PostBuildEvent matches the original .csproj (NOT
             Build) so the target fires at the same point in the build
             pipeline the original used. -->
	<Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(DeployToPhoenixPointTestMod)' != 'false'">
		<!-- Purge unwanted reference DLLs from the output so they never ship -->
		<Delete Files="$(OutputPath)0Harmony.dll" />
		<Delete Files="$(OutputPath)0Harmony.xml" />
		<Delete Files="$(OutputPath)Assembly-CSharp.dll" />
		<Delete Files="$(OutputPath)Unity.TextMeshPro.dll" />
		<Delete Files="$(OutputPath)UnityEngine.CoreModule.dll" />
		<Delete Files="$(OutputPath)UnityEngine.UI.dll" />

		<!-- Deploy the clean output to TestMod -->
		<Exec Command="IF EXIST &quot;%25USERPROFILE%25\AppData\LocalLow\Snapshot Games Inc\Phoenix Point\Steam\WorkshopTool\TestMod&quot; RMDIR /S /Q &quot;%25USERPROFILE%25\AppData\LocalLow\Snapshot Games Inc\Phoenix Point\Steam\WorkshopTool\TestMod&quot;" />
		<Exec Command="MKDIR &quot;%25USERPROFILE%25\AppData\LocalLow\Snapshot Games Inc\Phoenix Point\Steam\WorkshopTool\TestMod&quot; 2&gt;NUL" />
		<Exec Command="XCOPY /Y /S /Q &quot;$(OutputPath)*&quot; &quot;%25USERPROFILE%25\AppData\LocalLow\Snapshot Games Inc\Phoenix Point\Steam\WorkshopTool\TestMod&quot;" />
	</Target>
</Project>
