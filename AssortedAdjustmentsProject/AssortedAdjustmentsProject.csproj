<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<LangVersion>8.0</LangVersion>
		<OutputType>Library</OutputType>
		<AppDesignerFolder>Properties</AppDesignerFolder>
		<RootNamespace>SergeyWaytov.AssortedAdjustmentsProject</RootNamespace>
		<AssemblyName>SergeyWaytov_AssortedAdjustmentsProject</AssemblyName>
		<Deterministic>true</Deterministic>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<OutputPath>..\Dist</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
		<Optimize>false</Optimize>
		<DefineConstants>DEBUG;TRACE</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DebugType>pdbonly</DebugType>
		<Optimize>true</Optimize>
		<DefineConstants>TRACE</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="AbilityPatches.cs" />
		<Compile Include="AmbushDisabler.cs" />
		<Compile Include="ArmorPatches.cs" />
		<Compile Include="AssortedAdjustmentsProjectMain.cs" />
		<Compile Include="DefCache.cs" />
		<Compile Include="DeploymentCapPatch.cs" />
		<Compile Include="EconomyAmbushPatches.cs" />
		<Compile Include="GeoscapeFacilitiesPatches.cs" />
		<Compile Include="Helpers.cs" />
		<Compile Include="LootMechanics.cs" />
		<Compile Include="PoisonReworkEnforcer.cs" />
		<Compile Include="PrecisionShot.cs" />
		<Compile Include="Properties\AssemblyInfo.cs" />
		<Compile Include="PsychicBuffManager.cs" />
		<Compile Include="PsychicResearchConditions.cs" />
		<Compile Include="RageBurstPatch.cs" />
		<Compile Include="RegenTorsoEnforcer.cs" />
		<Compile Include="RepairCosts.cs" />
		<Compile Include="ResearchCompletePopupPatch.cs" />
		<Compile Include="ReturnFirePatch.cs" />
		<Compile Include="ScrapAircraftFix.cs" />
		<Compile Include="SquadEvacPatch.cs" />
		<Compile Include="StatEnforcer.cs" />
		<Compile Include="TutorialJacobFixPatch.cs" />
		<Compile Include="UIPatches.cs" />
		<Compile Include="UI_ExtendedAgendaTracker.cs" />
		<Compile Include="UI_ExtendedBaselineInfo.cs" />
		<Compile Include="UI_RecruitInfo.cs" />
		<Compile Include="UI_SmartBaseSelection.cs" />
		<Compile Include="VehiclePatches.cs" />
		<Compile Include="VenomTorsoEnforcer.cs" />
		<Compile Include="WeaponPatches.cs" />
		<Compile Include="WPCostDiscovery.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Include="meta.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<Content Include="Localization\AAP_Localization.csv">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Link>Assets\Localization\AAP_Localization.csv</Link>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Reference Include="0Harmony">
			<HintPath>..\ModSDK\0Harmony.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Assembly-CSharp">
			<HintPath>..\ModSDK\Assembly-CSharp.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Unity.TextMeshPro">
			<HintPath>..\ModSDK\Unity.TextMeshPro.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>..\ModSDK\UnityEngine.CoreModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.UI">
			<HintPath>..\ModSDK\UnityEngine.UI.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<!-- Purge unwanted reference DLLs from the output so they never ship -->
		<Delete Files="$(OutputPath)0Harmony.dll" />
		<Delete Files="$(OutputPath)0Harmony.xml" />
		<Delete Files="$(OutputPath)Assembly-CSharp.dll" />
		<Delete Files="$(OutputPath)Unity.TextMeshPro.dll" />
		<Delete Files="$(OutputPath)UnityEngine.CoreModule.dll" />
		<Delete Files="$(OutputPath)UnityEngine.UI.dll" />

		<!-- Deploy the clean output to TestMod -->
		<Exec Command="IF EXIST &quot;%25USERPROFILE%25\AppData\LocalLow\Snapshot Games Inc\Phoenix Point\Steam\WorkshopTool\TestMod&quot; RMDIR /S /Q &quot;%25USERPROFILE%25\AppData\LocalLow\Snapshot Games Inc\Phoenix Point\Steam\WorkshopTool\TestMod&quot;" />
		<Exec Command="MKDIR &quot;%25USERPROFILE%25\AppData\LocalLow\Snapshot Games Inc\Phoenix Point\Steam\WorkshopTool\TestMod&quot; 2&gt;NUL" />
		<Exec Command="XCOPY /Y /S /Q &quot;$(OutputPath)*&quot; &quot;%25USERPROFILE%25\AppData\LocalLow\Snapshot Games Inc\Phoenix Point\Steam\WorkshopTool\TestMod&quot;" />
	</Target>
</Project>